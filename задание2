#include <stdio.h>
#define MAX_SIZE 100

int main(void) {
    int a[MAX_SIZE]; 
    int n_size;      
    
    printf("Enter n (1..100): ");
    if (scanf("%d", &n_size) != 1) {
        printf("input error\n");
        return 1;
    }
    if (n_size < 1 || n_size > MAX_SIZE) {
        printf("Size error\n");
        return 1;
    }
    
    for (int i = 0; i < n_size; i++) {
        printf("a[%d]: ", i);
        if (scanf("%d", &a[i]) != 1) {
            printf("input error\n");
            return 1; 
        }
        if (a[i] < -1000 || a[i] > 1000) {
            printf("Value error\n");
            return 1;
        }
    }
    int b[MAX_SIZE];
    for (int i = 0; i < n_size; i++) {
        b[i] = a[i];
    }
    long long sum = 0;
    int p = 0; 
    
    for (int i = 0; i < n_size; i++) {
        if (b[i]<0) {
            b[i] = b[i]*0;
            p++;
        }
        sum += b[i];
    }
    
    double average = (double)sum / n_size;
    
    printf("Array: ");
    for (int i = 0; i < n_size; i++) {
        printf("%d ", b[i]); 
    }
    
    printf("\nSum = %lld\n", sum);
    printf("Zamena = %d\n", p);
    return 0;
}
